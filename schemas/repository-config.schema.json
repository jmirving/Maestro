{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/repository-config.schema.json",
  "title": "Maestro repository execution manifest",
  "type": "object",
  "required": ["repository", "work"],
  "properties": {
    "repository": { "type": "string", "minLength": 3 },
    "defaultBranch": { "type": "string", "minLength": 1, "default": "main" },
    "defaultConcurrency": { "type": "integer", "minimum": 1, "maximum": 8, "default": 2 },
    "planning": {
      "type": "object",
      "properties": {
        "analyzers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "labels"],
                "properties": {
                  "type": { "const": "shared-label" },
                  "labels": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
                  "confidence": { "enum": ["low", "medium", "high"] }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "advisoryConflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issues", "confidence", "source", "reason", "analyzer"],
            "properties": {
              "issues": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
              "confidence": { "enum": ["low", "medium", "high"] },
              "source": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "analyzer": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "agentAnalysis": {
          "type": "object",
          "required": ["analyzer", "provider", "contextDigest", "outputDigest", "attempts", "issueIds", "files", "recommendations"],
          "properties": {
            "analyzer": { "const": "agent" },
            "provider": { "type": "string", "minLength": 1 },
            "contextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "outputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "attempts": { "type": "integer", "minimum": 1 },
            "issueIds": { "type": "array", "items": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "uniqueItems": true },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "sha256", "truncated"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "truncated": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "recommendations": { "$ref": "https://maestro.local/schemas/agent-planning-output.schema.json" }
          },
          "additionalProperties": false
        },
        "agentAnalyses": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/agentAnalysis" }
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "allowFailing": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "preflight": { "type": "string" },
          "required": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      }
    },
    "integration": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "commands": { "type": "array", "items": { "type": "string" } },
        "postMergeCommands": { "type": "array", "items": { "type": "string" } },
        "closeIssues": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "properties": {
        "commands": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000, "default": 600000 }
      },
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "properties": {
        "labelMappings": {
          "type": "object",
          "properties": {
            "priority": { "type": "object", "additionalProperties": { "type": "number" } },
            "mode": { "type": "object", "additionalProperties": { "enum": ["execute", "research", "validate"] } },
            "requires": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } },
            "humanGate": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "worksets": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/workset" }
    },
    "work": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "enum": ["ready", "blocked", "human_gate", "inactive", "complete"] },
          "mode": { "enum": ["execute", "research", "validate"] },
          "priority": { "type": "number" },
          "blockedBy": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "requires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "humanGate": { "type": ["string", "null"] },
          "completion": {
            "type": "object",
            "required": ["source", "githubState", "githubStateReason", "evidence"],
            "properties": {
              "source": { "enum": ["external"] },
              "reconciledAt": { "type": "string", "minLength": 1 },
              "githubState": { "const": "CLOSED" },
              "githubStateReason": { "type": "string", "minLength": 1 },
              "evidence": {
                "type": "object",
                "required": ["manifestStatus", "maestroHistory"],
                "properties": {
                  "manifestStatus": { "const": "complete" },
                  "maestroHistory": { "type": "boolean" }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "github": {
            "type": "object",
            "required": ["state", "labels", "blockedBy"],
            "properties": {
              "state": { "enum": ["OPEN", "CLOSED"] },
              "stateReason": { "type": ["string", "null"] },
              "closedAt": { "type": ["string", "null"] },
              "updatedAt": { "type": ["string", "null"] },
              "title": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "blockedBy": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "mapped": {
                "type": "object",
                "properties": {
                  "priority": { "type": "number" },
                  "mode": { "enum": ["execute", "research", "validate"] },
                  "requires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "humanGate": { "type": "string" }
                },
                "additionalProperties": false
              },
              "manual": {
                "type": "object",
                "properties": {
                  "priority": { "type": "number" },
                  "mode": { "enum": ["execute", "research", "validate"] },
                  "blockedBy": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "requires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "humanGate": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "reconciliationHistory": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "reason"],
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "reason": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "issueRef": {
      "type": "object",
      "required": ["repository", "number"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "number": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      },
      "additionalProperties": false
    },
    "workset": {
      "type": "object",
      "required": ["source", "refresh"],
      "properties": {
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "issue"],
              "properties": {
                "type": { "const": "epic" },
                "issue": { "$ref": "#/$defs/issueRef" },
                "includeParent": { "type": "boolean", "default": false }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "issues"],
              "properties": {
                "type": { "const": "issues" },
                "issues": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/issueRef" },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "refresh": {
          "type": "object",
          "required": ["mode"],
          "properties": { "mode": { "const": "explicit" } },
          "additionalProperties": false
        },
        "executionPolicy": { "type": "string", "minLength": 1 },
        "completionPolicy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "agentAnalysis": {
      "type": "object",
      "required": ["analyzer", "provider", "contextDigest", "outputDigest", "attempts", "issueIds", "files", "recommendations"],
      "properties": {
        "analyzer": { "const": "agent" },
        "provider": { "type": "string", "minLength": 1 },
        "contextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "outputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "attempts": { "type": "integer", "minimum": 1 },
        "issueIds": { "type": "array", "items": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "uniqueItems": true },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256", "truncated"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "truncated": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "recommendations": { "$ref": "https://maestro.local/schemas/agent-planning-output.schema.json" }
      },
      "additionalProperties": false
    }
  }
}
