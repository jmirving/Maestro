{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/repository-config.schema.json",
  "title": "Maestro repository execution manifest",
  "type": "object",
  "required": ["repository", "work"],
  "properties": {
    "repository": { "type": "string", "minLength": 3 },
    "defaultBranch": { "type": "string", "minLength": 1, "default": "main" },
    "defaultConcurrency": { "type": "integer", "minimum": 1, "maximum": 8, "default": 2 },
    "planning": {
      "type": "object",
      "properties": {
        "analyzers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "labels"],
                "properties": {
                  "type": { "const": "shared-label" },
                  "labels": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
                  "confidence": { "enum": ["low", "medium", "high"] }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "advisoryConflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issues", "confidence", "source", "reason", "analyzer"],
            "properties": {
              "issues": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
              "confidence": { "enum": ["low", "medium", "high"] },
              "source": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "analyzer": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "agentAnalysis": {
          "type": "object",
          "required": ["analyzer", "provider", "contextDigest", "outputDigest", "attempts", "issueIds", "files", "recommendations"],
          "properties": {
            "analyzer": { "const": "agent" },
            "provider": { "type": "string", "minLength": 1 },
            "contextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "outputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "attempts": { "type": "integer", "minimum": 1 },
            "issueIds": { "type": "array", "items": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "uniqueItems": true },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "sha256", "truncated"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "truncated": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "recommendations": { "$ref": "https://maestro.local/schemas/agent-planning-output.schema.json" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "allowFailing": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "preflight": { "type": "string" },
          "required": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      }
    },
    "integration": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "commands": { "type": "array", "items": { "type": "string" } },
        "postMergeCommands": { "type": "array", "items": { "type": "string" } },
        "closeIssues": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "enum": ["ready", "blocked", "human_gate", "complete"] },
          "mode": { "enum": ["execute", "research", "validate"] },
          "priority": { "type": "number" },
          "blockedBy": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "requires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "humanGate": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
